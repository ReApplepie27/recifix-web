# Copy to .env and fill in. Never commit .env.

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# mysql://USER:PASSWORD@HOST:PORT/DATABASE  (URL-encode special characters in the password)
DATABASE_URL=mysql://recifix:your-db-password@127.0.0.1:3306/recifix

# Public address of the site; used to build links in emails.
BASE_URL=http://127.0.0.1:5000

# Set to 1 when the site is served over HTTPS.
SESSION_COOKIE_SECURE=0

# Optional: password-reset email. If SMTP_HOST is empty the reset link is printed in the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
MAIL_FROM=Recifix <no-reply@yourdomain.com>
